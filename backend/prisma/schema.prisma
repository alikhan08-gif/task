generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NotificationLevel {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                String            @id @default(uuid())
  email             String            @unique
  passwordHash      String
  timezone          String            @default("Asia/Tashkent")
  notificationLevel NotificationLevel @default(MEDIUM)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  tasks              Task[]
  xpTransactions     XPTransaction[]
  streak             Streak?
  telegramLink       TelegramLink?
  telegramLinkTokens TelegramLinkToken[]
  sentFriendRequests     FriendRequest[] @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("ReceivedFriendRequests")

  @@map("users")
}

model Task {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  dueAt           DateTime?
  status          TaskStatus @default(PENDING)
  completedAt     DateTime?
  remindEnabled   Boolean   @default(true)
  reminderSentAt  DateTime?
  reminderCount   Int       @default(0)
  clientUpdatedAt DateTime?
  version         Int       @default(1)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([userId, status])
  @@map("tasks")
}

enum TaskStatus {
  PENDING
  COMPLETED
  MISSED
}

model Streak {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak       Int       @default(0)
  longestStreak       Int       @default(0)
  lastCompletedDate   String?
  updatedAt           DateTime  @updatedAt

  @@map("streaks")
}

model XPTransaction {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  @@map("xp_transactions")
}

model TelegramLink {
  userId       String   @id
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  telegramChatId String @unique
  linkedAt     DateTime @default(now())

  @@map("telegram_links")
}

/// Foydalanuvchi mobil ilovada "Telegram bilan bog'lash"ni bosganda yaratiladigan
/// bir martalik token. Bot /start <token> qabul qilganda ishlatiladi va o'chiriladi.
model TelegramLinkToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("telegram_link_tokens")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// ACCEPTED holatidagi yozuv ikki foydalanuvchi o'rtasidagi do'stlikni ifodalaydi
/// (yo'nalishidan qat'i nazar) — alohida "Friendship" jadvali shart emas.
model FriendRequest {
  id          String              @id @default(uuid())
  senderId    String
  sender      User                @relation("SentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId  String
  receiver    User                @relation("ReceivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  respondedAt DateTime?

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@map("friend_requests")
}
